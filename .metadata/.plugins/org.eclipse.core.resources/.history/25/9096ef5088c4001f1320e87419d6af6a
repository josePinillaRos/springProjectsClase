	private static void borrarLenguaje() {
		// 1. Mostrar todos los lenguajes
	    List<Language> lenguajes = HibernateUtils.getAll(Language.class);
	    if (lenguajes.isEmpty()) {
	        System.out.println("No hay lenguajes disponibles para borrar.");
	        return;
	    }
	    lenguajes.forEach(System.out::println);

	    // 2. Solicitar el ID del lenguaje a borrar
	    Language lenguajeABorrar = null;
	    while (lenguajeABorrar == null) {
	        System.out.print("\nIntroduzca el id del lenguaje a borrar: ");
	        String entrada = sc.nextLine();

	        try {
	            int id = Integer.parseInt(entrada);

	            // Buscar el lenguaje
	            lenguajeABorrar = HibernateUtils.getId(Language.class, id);
	            if (lenguajeABorrar == null) {
	                System.out.println("No existe ningún lenguaje con ese ID. Inténtelo de nuevo.");
	            }
	        } catch (NumberFormatException e) {
	            System.out.println("Entrada no válida. Por favor, introduzca un número.");
	        }
	    }

	    // 3. Comprobar los jokes asociados
	    Set<Jokes> jokesAsociados = lenguajeABorrar.getJokeses();
	    if (jokesAsociados != null && !jokesAsociados.isEmpty()) {
	        System.out.println("El lenguaje con ID " + lenguajeABorrar.getId() +
	                " está asociado a " + jokesAsociados.size() + " joke(s).");

	        // Preguntar qué hacer: desvincular o borrar los jokes
	        System.out.println("¿Qué desea hacer con esos jokes?");
	        System.out.println("1. Desvincular los chistes (poner el lenguaje a null)");
	        System.out.println("2. Borrar los chistes asociados");
	        System.out.println("3. Cancelar la operación");
	        System.out.print("Opción: ");
	        String opcion = sc.nextLine().trim();

	        switch (opcion) {
	            case "1":
	                // Desvincular el lenguaje de cada Joke
	                for (Jokes j : jokesAsociados) {
	                    j.setLanguage(null);
	                    HibernateUtils.merge(j);
	                }
	                System.out.println("Se han desvinculado " + jokesAsociados.size() + " chistes del lenguaje.");
	                break;

	            case "2":
	                // Borrar los jokes asociados
	                System.out.println("Va a borrar " + jokesAsociados.size() + " chistes asociados al lenguaje.");
	                System.out.print("¿Está seguro? (S/N): ");
	                String confirmacion = sc.nextLine().trim().toLowerCase();
	                if (!confirmacion.equals("s")) {
	                    System.out.println("Operación cancelada. No se ha borrado el lenguaje.");
	                    return;
	                }

	                for (Jokes j : jokesAsociados) {
	                    boolean resultadoBorradoJoke = HibernateUtils.remove(j);
	                    if (!resultadoBorradoJoke) {
	                        System.out.println("Error al borrar el chiste con ID: " + j.getId() + ". Operación cancelada.");
	                        return;
	                    }
	                }
	                System.out.println("Se han borrado " + jokesAsociados.size() + " chistes asociados al lenguaje.");
	                break;

	            default:
	                System.out.println("Operación cancelada. No se ha borrado el lenguaje.");
	                return;
	        }
	    }

	    // 4. Borrar el lenguaje
	    boolean resultado = HibernateUtils.remove(lenguajeABorrar);
	    if (resultado) {
	        System.out.println("Lenguaje borrado correctamente (ID: " + lenguajeABorrar.getId() + ").");
	    } else {
	        System.out.println("Ha ocurrido un error al intentar borrar el lenguaje.");
	    }
	}
	

	private static void borrarCategoria() {
	    // 1. Mostrar todas las categorías
	    List<Categories> categorias = HibernateUtils.getAll(Categories.class);
	    if (categorias.isEmpty()) {
	        System.out.println("No hay categorías disponibles para borrar.");
	        return;
	    }
	    categorias.forEach(System.out::println);

	    // 2. Solicitar el ID de la categoría a borrar
	    Categories categoriaABorrar = null;
	    while (categoriaABorrar == null) {
	        System.out.print("\nIntroduzca el id de la categoría a borrar: ");
	        String entrada = sc.nextLine();

	        try {
	            int id = Integer.parseInt(entrada);

	            // Buscar la categoría
	            categoriaABorrar = HibernateUtils.getId(Categories.class, id);
	            if (categoriaABorrar == null) {
	                System.out.println("No existe ninguna categoría con ese ID. Inténtelo de nuevo.");
	            }
	        } catch (NumberFormatException e) {
	            System.out.println("Entrada no válida. Por favor, introduzca un número.");
	        }
	    }

	    // 3. Comprobar los jokes asociados
	    Set<Jokes> jokesAsociados = categoriaABorrar.getJokeses();
	    if (jokesAsociados != null && !jokesAsociados.isEmpty()) {
	        System.out.println("La categoría con ID " + categoriaABorrar.getId() +
	                " está asociada a " + jokesAsociados.size() + " joke(s).");

	        // 3.1 Preguntar qué hacer: desvincular o borrar los jokes
	        System.out.println("¿Qué desea hacer con esos jokes?");
	        System.out.println("1. Desvincular los chistes (poner la categoría a null)");
	        System.out.println("2. Borrar los chistes asociados");
	        System.out.println("3. Cancelar la operación");
	        System.out.print("Opción: ");
	        String opcion = sc.nextLine().trim();

	        switch (opcion) {
	            case "1":
	                // Desvincular la categoría de cada Joke
	                for (Jokes j : jokesAsociados) {
	                    j.setCategories(null);
	                    // Actualizar el Joke para no violar la foreign key al eliminar la categoría
	                    HibernateUtils.merge(j);
	                }
	                System.out.println("Se han desvinculado " + jokesAsociados.size() + " chistes de la categoría.");
	                break;

	            case "2":
	                // Borrar los chistes asociados
	                System.out.println("Va a borrar " + jokesAsociados.size() + " chistes asociados a la categoría.");
	                System.out.print("¿Está seguro? (S/N): ");
	                String confirmacion = sc.nextLine().trim().toLowerCase();
	                if (!confirmacion.equals("s")) {
	                    System.out.println("Operación cancelada. No se ha borrado la categoría.");
	                    return;
	                }

	                // Borrar cada Joke
	                for (Jokes j : jokesAsociados) {
	                    boolean resultadoBorradoJoke = HibernateUtils.remove(j);
	                    if (!resultadoBorradoJoke) {
	                        System.out.println("Error al borrar el chiste con ID: " + j.getId() + ". Operación cancelada.");
	                        return;
	                    }
	                }
	                System.out.println("Se han borrado " + jokesAsociados.size() + " chistes asociados a la categoría.");
	                break;

	            default:
	                // 3.2 Cancelar la operación
	                System.out.println("Operación cancelada. No se ha borrado la categoría.");
	                return;
	        }
	    }

	    // 4. Borrar la categoría
	    boolean resultado = HibernateUtils.remove(categoriaABorrar);
	    if (resultado) {
	        System.out.println("Categoría borrada correctamente (ID: " + categoriaABorrar.getId() + ").");
	    } else {
	        System.out.println("Ha ocurrido un error al intentar borrar la categoría.");
	    }
